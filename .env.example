# Server
# Runtime environment: development | production | test
NODE_ENV=development
# Port the Express server listens on
PORT=5051
# Bind address. Loopback by default so the dev server is NOT exposed to the local
# network (cafe/hotel wifi). Set HOST=0.0.0.0 to serve all interfaces — e.g. to
# reach this machine from another over Tailscale.
#
# Keep this SET rather than commented out. Some tool/agent environments export
# HOST as the machine hostname (e.g. mac-mini-m4.local); with no value here,
# that leaks through and the server binds the wrong interface with no error —
# it starts, logs look normal, and only connections fail. env.ts loads this file
# with override:true, so an explicit value here always wins.
HOST=127.0.0.1
# Origin the Vite dev server runs on (used for CORS)
CLIENT_URL=http://localhost:5050

# Client (Vite — prefix VITE_ required)
# Base URL for API requests. Leave empty to use the Vite dev proxy.
VITE_API_URL=
# Application display name shown in the UI
VITE_APP_NAME=AppyStack
# Socket.io server URL. Leave empty to use window.location.origin (default).
# Set explicitly to bypass Vite WebSocket proxy upgrade issues in dev.
VITE_SOCKET_URL=http://localhost:5051

# Git sync polling interval in milliseconds (default: 120000 = 2 minutes)
# GIT_SYNC_POLL_MS=120000
